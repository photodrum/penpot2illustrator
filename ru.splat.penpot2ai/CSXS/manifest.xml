<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="ru.splat.penpot2ai" ExtensionBundleVersion="0.6.2"
  ExtensionBundleName="Penpot → Illustrator" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="ru.splat.penpot2ai.panel" Version="0.6.2"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[23.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="ru.splat.penpot2ai.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Penpot → Illustrator</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>300</Width></Size>
            <MinSize><Height>300</Height><Width>240</Width></MinSize>
            <MaxSize><Height>2000</Height><Width>800</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon_normal.png</Icon>
            <Icon Type="RollOver">./icons/icon_rollover.png</Icon>
            <Icon Type="DarkNormal">./icons/icon_dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon_dark_rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
